#!/usr/bin/env bash
# systemd-sleep hook: after suspend/resume, restart the dashcam services so USB
# camera handles, V4L2 state, Wi-Fi AP state, and recorder threads come back cleanly.

set -euo pipefail

case "${1:-}" in
  post)
    /usr/bin/systemctl restart car-logger-ap.service || true
    /usr/bin/systemctl restart car-incident-logger.service || true
    /usr/bin/systemctl restart car-incident-power-watch.service || true
    ;;
esac
