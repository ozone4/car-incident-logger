[Unit]
Description=Car Incident Logger dashboard and recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__PROJECT_DIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=__PROJECT_DIR__/.venv/bin/python web/app.py --host 0.0.0.0 --port 5000
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM

# Keep appliance logs queryable with: journalctl -u car-incident-logger -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
